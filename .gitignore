# ==============================================================================
# Textract — Hackathon Repository .gitignore
# Clean, production-ready ignore rules for submission
# ==============================================================================

# Bytecode, Caches & Compiled Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
backend/.venv/

# Environment Variables & Secrets
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Sample Media, Test Flyers & Screenshots
sample_aws.png
web-demo/sample_aws.png
demo_flyer_*
extracted_screenshots/
slide_previews/
demo_assets/

# Presentations, PDFs & Office Temporary Lock Files
*.pptx
*.ppt
*.pdf
~$*

# Android / Gradle Build Artifacts
.gradle/
build/
app/build/
local.properties
*.apk
*.ap_
*.aab
*.dex
*.class
.cxx/
captures/
*.keystore
*.jks

# IDE & Editor Settings
.idea/
.vscode/
*.swp
*.swo
*~

# Operating System Junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Vercel & Runtime Logs
.vercel/
*.log

# Pitch, Presentation Drafts & Submission Notes
SUBMISSION_PITCH.md
submissionpitch.md
*pitch*.md
*submission*.md
pitch/
pitches/
drafts/

